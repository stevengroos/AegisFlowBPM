):
    check_settings_permission(db, current_user, "manage_blueprints")
    
    bp = db.query(models.Blueprint).filter(
        models.Blueprint.id == transition_in.blueprint_id,
        models.Blueprint.company_id == current_user.company_id
    ).first()
    
    if not bp:
