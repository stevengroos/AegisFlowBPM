        entity_type="WORKFLOW", action="EMAIL_APPROVAL", entity_id=case.id,
        details=f"Aprobó desde el correo el caso #{case.id} vía '{transition.name}'", 
        request=request
    )
    
    db.commit()

    # 6. Pantalla de Éxito HTML
