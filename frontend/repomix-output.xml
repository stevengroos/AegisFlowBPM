                    return null;
                  })()}
                </div>
              </div>

              {reportForm.visual_config.module_id && queryBuilderFields.length > 0 && (
                <div className="bg-gray-50 dark:bg-[#1e1e1e] p-5 rounded-xl border border-gray-200 dark:border-gray-800">
